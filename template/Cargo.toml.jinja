[workspace]
members = ["plugin", "xtask"]
resolver = "3"

[workspace.package]
version = "0.1.0"
edition = "2024"
license = "{{ license }}"
authors = ["{{ author_name }} <{{ author_email }}>"]
repository = "{{ repository }}"

[workspace.dependencies]
crabgram = { git = "https://github.com/kimhappy/crabgram" }
crabgram-build = { git = "https://github.com/kimhappy/crabgram" }
{% if styling %}crabgram-styling = { git = "https://github.com/kimhappy/crabgram" }
{% endif %}{{ project_slug }} = { path = "plugin" }

[workspace.lints.rust]
incomplete_features = "allow"
missing_docs = "warn"

[workspace.lints.clippy]
all = { level = "warn", priority = -1 }
pedantic = { level = "warn", priority = -1 }
nursery = { level = "warn", priority = -1 }

cast_possible_truncation = "allow"
cast_precision_loss = "allow"
float_cmp = "allow"
missing_const_for_fn = "allow"
suboptimal_flops = "allow"
use_self = "allow"

[profile.release]
panic = "abort"
lto = true
codegen-units = 1
strip = true
